# ==============================================================================
# TalentTrack AI — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
# Server-only variables (DATABASE_URL, SESSION_SECRET, API keys) must never be
# exposed to the client bundle.
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# Database Configuration (MongoDB & Mongoose)
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/talenttrack?retryWrites=true&w=majority
# Local / Self-hosted: mongodb://127.0.0.1:27017/talenttrack
MONGODB_URI=mongodb://127.0.0.1:27017/talenttrack
DATABASE_URL=mongodb://127.0.0.1:27017/talenttrack
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_TIMEOUT_MS=5000

# Background Worker & Durable Job Queue
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_RETRIES=3

# Database Backup & Retention
BACKUP_DIR=./backups
RETENTION_DAYS=14

# Authentication & Session Security
SESSION_SECRET=your-random-session-secret-at-least-32-chars
JWT_SECRET=your-random-jwt-secret-key-for-tokens
JWT_EXPIRES_IN=7d

# AI Provider Integrations
OPENAI_API_KEY=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Firebase Web Configuration (Client-side for Applicants)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=talenttrack-ai-75a10.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talenttrack-ai-75a10
VITE_FIREBASE_STORAGE_BUCKET=talenttrack-ai-75a10.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=522852717438
VITE_FIREBASE_APP_ID=1:522852717438:web:d6d24b4d5961545d8c592f

# Firebase Admin Configuration (Server-side Only)
FIREBASE_PROJECT_ID=talenttrack-ai-75a10
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage / Resume Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email Delivery & SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talenttrack.ai
SMTP_FROM_NAME="TalentTrack AI"
