# ==============================================================================
# TalentTrack AI — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files containing real secrets to version control.
# Server-only variables (DATABASE_URL, SESSION_SECRET, API keys) must never be
# exposed to the client bundle.
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# Database Configuration (MongoDB & Mongoose)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/talenttrack?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/talenttrack

# Authentication & Session Security (Planned Phase 2)
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI Provider Integrations
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Firebase Web Configuration (Client-side for Applicants)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=talenttrack-ai-75a10.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talenttrack-ai-75a10
VITE_FIREBASE_STORAGE_BUCKET=talenttrack-ai-75a10.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=522852717438
VITE_FIREBASE_APP_ID=1:522852717438:web:d6d24b4d5961545d8c592f

# Firebase Admin Configuration (Server-side Only)
FIREBASE_PROJECT_ID=talenttrack-ai-75a10
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object Storage / Resume Storage (Planned Phase 5)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email Delivery & SMTP (Planned Phase 8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talenttrack.ai
SMTP_FROM_NAME="TalentTrack AI"

